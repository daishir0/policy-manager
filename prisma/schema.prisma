// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// 認証・ユーザー管理
// ========================================

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String    // bcryptハッシュ
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(STAFF)

  // ロック関連
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // タイムスタンプ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // リレーション
  accounts        Account[]
  sessions        Session[]
  documents       Document[]         @relation("CreatedDocuments")
  assignedDocs    Document[]         @relation("AssignedDocuments")
  editedVersions  DocumentVersion[]  @relation("EditedVersions")
  accessLogs      AccessLog[]
  qaInteractions  QAInteraction[]
  bookmarks       Bookmark[]
  messages        Message[]          @relation("ReceivedMessages")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ========================================
// 文書管理
// ========================================

model Document {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  status      DocumentStatus @default(DRAFT)

  // バージョン管理
  currentVersion  String   @default("1.0")

  // 作成者
  createdById String
  createdBy   User     @relation("CreatedDocuments", fields: [createdById], references: [id])

  // 担当者（デフォルトはcreatedById）
  assigneeId  String?
  assignee    User?    @relation("AssignedDocuments", fields: [assigneeId], references: [id])

  // タイムスタンプ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // 論理削除

  // リレーション
  versions      DocumentVersion[]
  attachments   Attachment[]
  dependencies  DocumentDependency[] @relation("DependentDocument")
  dependents    DocumentDependency[] @relation("DependencyDocument")
  accessLogs    AccessLog[]
  bookmarks     Bookmark[]
  embeddings    DocumentEmbedding[]
  permissions   DocumentPermission[]
  messages      Message[]

  @@index([status])
  @@index([createdById])
  @@index([assigneeId])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  version     String   // "1.0", "1.1", "2.0" etc.
  title       String
  content     String   @db.Text
  changeNote  String?  @db.Text // 変更内容の説明

  // 編集者
  editedById  String
  editedBy    User     @relation("EditedVersions", fields: [editedById], references: [id])

  createdAt   DateTime @default(now())

  @@index([documentId])
  @@index([version])
  @@map("document_versions")
}

enum DocumentStatus {
  DRAFT      // 下書き
  PUBLISHED  // 公開中
  RETIRED    // 廃止
}

// ========================================
// 添付ファイル
// ========================================

model Attachment {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  fileName    String
  mimeType    String
  fileSize    Int      // bytes
  storagePath String   // ファイル保存パス
  extractedText String? @db.Text // PDF等から抽出したテキスト

  createdAt DateTime @default(now())

  @@index([documentId])
  @@map("attachments")
}

// ========================================
// 依存関係
// ========================================

model DocumentDependency {
  id                 String   @id @default(cuid())
  dependentDocId     String   // 依存する文書（子）
  dependentDoc       Document @relation("DependentDocument", fields: [dependentDocId], references: [id], onDelete: Cascade)
  dependencyDocId    String   // 依存される文書（親）
  dependencyDoc      Document @relation("DependencyDocument", fields: [dependencyDocId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([dependentDocId, dependencyDocId])
  @@index([dependentDocId])
  @@index([dependencyDocId])
  @@map("document_dependencies")
}

// ========================================
// RAG / ベクトル検索
// ========================================

model DocumentEmbedding {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex  Int      // ドキュメント内のチャンク番号
  chunkText   String   @db.Text
  embedding   Json     // 768次元のfloat配列をJSONとして保存

  createdAt   DateTime @default(now())

  @@index([documentId])
  @@map("document_embeddings")
}

// ========================================
// 対話型Q&A
// ========================================

model QAInteraction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  sessionId   String   // 会話セッションID

  question    String   @db.Text
  answer      String   @db.Text
  sources     Json?    // 参照文書IDと該当箇所
  confidence  Float?   // 回答の信頼度

  // フィードバック
  feedbackRating Int?  // 1-5
  feedbackComment String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@map("qa_interactions")
}

// ========================================
// アクセスログ・分析
// ========================================

model AccessLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  action      String   // view, search, download, qa_ask
  details     Json?    // 検索クエリ等
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([documentId])
  @@index([action])
  @@index([createdAt])
  @@map("access_logs")
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  note        String?

  createdAt   DateTime @default(now())

  @@unique([userId, documentId])
  @@map("bookmarks")
}

// ========================================
// 文書単位権限
// ========================================

model DocumentPermission {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // 権限対象（ユーザー）
  userId         String?

  // 権限レベル
  permissionLevel DocumentPermissionLevel @default(READ)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, userId])
  @@index([documentId])
  @@index([userId])
  @@map("document_permissions")
}

enum DocumentPermissionLevel {
  READ       // 閲覧のみ
  WRITE      // 編集可能
  ADMIN      // 権限管理可能
}

// ========================================
// メッセージ（矛盾チェック通知等）
// ========================================

model Message {
  id         String    @id @default(cuid())
  userId     String    // 受信者
  user       User      @relation("ReceivedMessages", fields: [userId], references: [id], onDelete: Cascade)
  content    String    @db.Text
  documentId String?   // 関連文書（任意）
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  readAt     DateTime? // 既読日時（nullなら未読）

  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([documentId])
  @@index([readAt])
  @@map("messages")
}

// ========================================
// 監査ログ
// ========================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // login, logout, create_doc, update_doc, delete_doc, etc.
  entityType  String?  // document, user, role, etc.
  entityId    String?
  details     Json?
  ipAddress   String?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
