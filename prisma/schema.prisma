// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// 認証・ユーザー管理 (Auth.js + RBAC)
// ========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String    // bcryptハッシュ
  emailVerified DateTime?
  image         String?
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])

  // ロック関連
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // タイムスタンプ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // リレーション
  accounts      Account[]
  sessions      Session[]
  documents     Document[]        @relation("CreatedDocuments")
  editedVersions DocumentVersion[] @relation("EditedVersions")
  accessLogs    AccessLog[]
  qaInteractions QAInteraction[]
  bookmarks     Bookmark[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // system_admin, document_admin, employee
  displayName String
  description String?
  permissions String[] // 権限の配列

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("roles")
}

// ========================================
// 文書管理 (Document Versioning Pattern)
// ========================================

model Document {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  summary     String?  @db.Text
  status      DocumentStatus @default(DRAFT)

  // バージョン管理
  currentVersion  String   @default("1.0")

  // 施行管理
  effectiveDate   DateTime?  // 施行日
  expirationDate  DateTime?  // 廃止日

  // 作成者
  createdById String
  createdBy   User     @relation("CreatedDocuments", fields: [createdById], references: [id])

  // タイムスタンプ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? // 論理削除

  // リレーション
  versions      DocumentVersion[]
  categories    DocumentCategory[]
  organizations DocumentOrganization[]
  attachments   Attachment[]
  dependencies  DocumentDependency[] @relation("DependentDocument")
  dependents    DocumentDependency[] @relation("DependencyDocument")
  accessLogs    AccessLog[]
  bookmarks     Bookmark[]
  embeddings    DocumentEmbedding[]
  permissions   DocumentPermission[]

  @@index([status])
  @@index([createdById])
  @@index([effectiveDate])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  version     String   // "1.0", "1.1", "2.0" etc.
  title       String
  content     String   @db.Text
  summary     String?  @db.Text
  changeNote  String?  @db.Text // 変更内容の説明

  // 編集者
  editedById  String
  editedBy    User     @relation("EditedVersions", fields: [editedById], references: [id])

  createdAt   DateTime @default(now())

  @@index([documentId])
  @@index([version])
  @@map("document_versions")
}

enum DocumentStatus {
  DRAFT      // 下書き
  PUBLISHED  // 公開中
  RETIRED    // 廃止
}

// ========================================
// 分類・組織
// ========================================

model Category {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  sortOrder   Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents DocumentCategory[]

  @@index([parentId])
  @@map("categories")
}

model DocumentCategory {
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([documentId, categoryId])
  @@map("document_categories")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique // 部門コード
  parentId    String?
  parent      Organization?  @relation("OrganizationHierarchy", fields: [parentId], references: [id])
  children    Organization[] @relation("OrganizationHierarchy")
  sortOrder   Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents DocumentOrganization[]

  @@index([parentId])
  @@map("organizations")
}

model DocumentOrganization {
  documentId     String
  document       Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([documentId, organizationId])
  @@map("document_organizations")
}

// ========================================
// 添付ファイル
// ========================================

model Attachment {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  fileName    String
  mimeType    String
  fileSize    Int      // bytes
  storagePath String   // ファイル保存パス

  createdAt DateTime @default(now())

  @@index([documentId])
  @@map("attachments")
}

// ========================================
// 依存関係
// ========================================

model DocumentDependency {
  id                 String   @id @default(cuid())
  dependentDocId     String   // 依存する文書（子）
  dependentDoc       Document @relation("DependentDocument", fields: [dependentDocId], references: [id], onDelete: Cascade)
  dependencyDocId    String   // 依存される文書（親）
  dependencyDoc      Document @relation("DependencyDocument", fields: [dependencyDocId], references: [id], onDelete: Cascade)

  relationshipType   String?  // 参照、引用、補足など
  description        String?

  createdAt DateTime @default(now())

  @@unique([dependentDocId, dependencyDocId])
  @@index([dependentDocId])
  @@index([dependencyDocId])
  @@map("document_dependencies")
}

// ========================================
// RAG / ベクトル検索
// ========================================

model DocumentEmbedding {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex  Int      // ドキュメント内のチャンク番号
  chunkText   String   @db.Text
  embedding   Json     // 768次元のfloat配列をJSONとして保存（pgvector未インストール時の代替）

  createdAt   DateTime @default(now())

  @@index([documentId])
  @@map("document_embeddings")
}

// ========================================
// 対話型Q&A
// ========================================

model QAInteraction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  sessionId   String   // 会話セッションID

  question    String   @db.Text
  answer      String   @db.Text
  sources     Json?    // 参照文書IDと該当箇所
  confidence  Float?   // 回答の信頼度

  // フィードバック
  feedbackRating Int?  // 1-5
  feedbackComment String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@map("qa_interactions")
}

// ========================================
// アクセスログ・分析
// ========================================

model AccessLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  action      String   // view, search, download, qa_ask
  details     Json?    // 検索クエリ等
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([documentId])
  @@index([action])
  @@index([createdAt])
  @@map("access_logs")
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  note        String?

  createdAt   DateTime @default(now())

  @@unique([userId, documentId])
  @@map("bookmarks")
}

// ========================================
// 提案
// ========================================

model Proposal {
  id          String   @id @default(cuid())
  type        ProposalType
  title       String
  description String   @db.Text
  reasoning   String   @db.Text // 提案理由（AI分析結果等）

  status      ProposalStatus @default(PENDING)

  // 関連文書
  relatedDocuments Json? // 関連文書ID配列

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@map("proposals")
}

enum ProposalType {
  REVISION   // 改訂提案
  NEW        // 新設提案
}

enum ProposalStatus {
  PENDING    // 未対応
  ACCEPTED   // 採用
  REJECTED   // 却下
}

// ========================================
// 文書単位権限
// ========================================

model DocumentPermission {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  // 権限対象（ユーザーまたは組織）
  userId         String?
  organizationId String?

  // 権限レベル
  permissionLevel DocumentPermissionLevel @default(READ)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, userId])
  @@unique([documentId, organizationId])
  @@index([documentId])
  @@index([userId])
  @@index([organizationId])
  @@map("document_permissions")
}

enum DocumentPermissionLevel {
  READ       // 閲覧のみ
  WRITE      // 編集可能
  ADMIN      // 権限管理可能
}

// ========================================
// 監査ログ
// ========================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // login, logout, create_doc, update_doc, delete_doc, etc.
  entityType  String?  // document, user, role, etc.
  entityId    String?
  details     Json?
  ipAddress   String?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
