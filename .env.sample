# ========================================
# Policy Manager - Environment Variables Template
# ========================================
# Copy this file to .env and fill in the values
# cp .env.sample .env

# ----------------------------------------
# Database (PostgreSQL + pgvector)
# ----------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/policy_manager?schema=public"

# ----------------------------------------
# Authentication (Auth.js / NextAuth.js)
# ----------------------------------------
# Generate a strong random secret for production:
# openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="https://your-domain.com"

# ----------------------------------------
# AI Services (Claude API)
# ----------------------------------------
ANTHROPIC_API_KEY="sk-ant-..."

# ----------------------------------------
# Embedding API (Optional)
# ----------------------------------------
# For multilingual-e5-large or compatible embedding API
# EMBEDDING_API_URL="http://localhost:11434/api/embeddings"
# EMBEDDING_MODEL="multilingual-e5-large"
# EMBEDDING_DIMENSIONS="768"

# ----------------------------------------
# Application Settings
# ----------------------------------------
NODE_ENV="production"
PORT="3018"

# ----------------------------------------
# E2E Testing (Playwright)
# ----------------------------------------
# Required for running E2E tests
# Tests must be run against the production URL (not localhost)
PLAYWRIGHT_BASE_URL="https://your-domain.com"

# ----------------------------------------
# Test User Credentials (for E2E tests)
# ----------------------------------------
TEST_USER_EMAIL="admin@example.com"
TEST_USER_PASSWORD="password123"

# ----------------------------------------
# Optional: External Services
# ----------------------------------------
# SMTP configuration for notifications (future feature)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""
